DATABASE_URL=postgres://payflow:payflow@localhost:5432/payflow?sslmode=disable
PAYFLOW_ENV=development
PAYFLOW_DB_MAX_CONNS=10
PAYFLOW_DB_CONNECT_TIMEOUT=5s
PAYFLOW_MIGRATION_TIMEOUT=5m
LISTEN_ADDR=127.0.0.1:8080
PAYFLOW_ENABLE_DEV_PROCESSING=false
TEMPORAL_ADDRESS=127.0.0.1:7233
TEMPORAL_NAMESPACE=default
TEMPORAL_TASK_QUEUE=payflow-payments
PAYFLOW_RECONCILE_INTERVAL=2s
PAYFLOW_RECONCILE_MAX_INTERVAL=30s
PAYFLOW_RECONCILE_WINDOW=2m
PAYFLOW_REQUEST_TIMEOUT=15s
PAYFLOW_METRICS_ADDR=127.0.0.1:9090
PAYFLOW_WORKER_METRICS_ADDR=127.0.0.1:9091
PAYFLOW_RECOVERY_INTERVAL=10s
PAYFLOW_RECOVERY_MAX_INTERVAL=5m
PAYFLOW_RECOVERY_MAX_ATTEMPTS=8
